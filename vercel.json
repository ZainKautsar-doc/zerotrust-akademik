{
  "version": 2,
  "rewrites": [
    {
      "source": "/auth/(.*)",
      "destination": "/api/index.js"
    },
    {
      "source": "/api/(.*)",
      "destination": "/api/index.js"
    },
    {
      "source": "/nilai/(.*)",
      "destination": "/api/index.js"
    },
    {
      "source": "/nilai",
      "destination": "/api/index.js"
    },
    {
      "source": "/kelas/(.*)",
      "destination": "/api/index.js"
    },
    {
      "source": "/kelas",
      "destination": "/api/index.js"
    },
    {
      "source": "/transkrip/(.*)",
      "destination": "/api/index.js"
    },
    {
      "source": "/transkrip",
      "destination": "/api/index.js"
    },
    {
      "source": "/(.*)",
      "destination": "/frontend/dist/$1"
    }
  ]
}
